# Copy this file to .env.local and fill in real values.

# Postgres (Neon) — https://neon.tech. Create a free project, copy its
# connection string here. Run `npm run db:migrate` after setting this to
# create the schema (also runs automatically before `dev`/`build`).
DATABASE_URL=

# Site URL used for Coinbase Commerce redirect/cancel URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Coinbase Commerce (crypto payments) — https://commerce.coinbase.com/dashboard/settings
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=

# SMTP (bank transfer confirmation emails). Leave blank to log emails to the
# server console instead of sending them.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Signs customer session cookies + unsubscribe links. Set any random string
# in production — falls back to a fixed dev value locally.
SESSION_SECRET=

# Executive terminals — separate passwords so either can be revoked
# independently. Both read the same underlying store data.
COMMAND_PASSWORD=
OFFICE_PASSWORD=

# Resend (marketing email compose/send in the executive terminals)
RESEND_API_KEY=
MARKETING_EMAIL_FROM=

# Anthropic (executive "Assistant" tab)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
